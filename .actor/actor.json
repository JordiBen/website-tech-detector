{
  "actorSpecification": 1,
  "name": "website-tech-detector",
  "title": "Website Tech Stack Detector: BuiltWith & Wappalyzer Alternative",
  "description": "Find out what any website is built with: CMS (WordPress, Shopify...), JS frameworks, analytics, tag managers, CDN, hosting, payments, email provider and SaaS tools, with versions. A BuiltWith/Wappalyzer-style technology lookup in bulk, 4,000+ fingerprints. $2 per 1,000 sites.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "input",
              "finalUrl",
              "technologyCount",
              "categories",
              "technologyNames",
              "error"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "input": {
                "label": "Site"
              },
              "finalUrl": {
                "label": "Final URL",
                "format": "link"
              },
              "technologyCount": {
                "label": "# Tech",
                "format": "number"
              },
              "categories": {
                "label": "Categories",
                "format": "array"
              },
              "technologyNames": {
                "label": "Technologies (enable 'flatten')"
              },
              "error": {
                "label": "Error"
              }
            }
          }
        }
      }
    }
  }
}
